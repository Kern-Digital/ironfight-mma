rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Identitaet: ausschliesslich aus signierten Auth Custom Claims ─────
    // (per Admin-SDK gesetzt — kein Client kann ein Recht oder gymId schreiben)

    // ROLLEN-SET (Checkpoint 3, Konzept §1): drei unabhaengige Haekchen
    // `trainer`, `verwaltung`, `admin` statt eines `role`-Wertes. Der alte
    // Wert konnte immer nur EINES davon ausdruecken — deshalb musste
    // `verwaltung` 2026-08-31 schon daneben entstehen, und `trainer` und
    // `admin` konkurrierten um denselben Platz.
    // Serverseitige Entsprechung: lib/roles.ts.
    //
    // legacyRole() IST DER MIGRATIONSPFAD, KEINE ZWEITE QUELLE: Ausgestellte
    // ID-Tokens leben bis zu einer Stunde, in der Tokens beider Formen durch
    // diese Regeln laufen. Faellt der Rueckfall weg, verliert jeder Trainer
    // mit noch gueltigem Token schlagartig seinen Zugriff. Er verschwindet,
    // sobald die Produktion laenger als eine Stunde neu laeuft.
    function legacyRole() {
      return ("role" in request.auth.token) ? request.auth.token.role : "user";
    }
    function isAdmin() {
      return (("admin" in request.auth.token) && request.auth.token.admin == true)
             || legacyRole() == "admin";
    }
    function isTrainerOrAdmin() {
      return (("trainer" in request.auth.token) && request.auth.token.trainer == true)
             || legacyRole() == "trainer"
             || isAdmin();
    }
    // Gym aus dem Token. Fehlender Claim = Default-Gym (Bestand vor Migration
    // und frische Signups ohne Einladung — Phase 2 setzt Claims via Invite).
    function userGymId() {
      return ("gymId" in request.auth.token) ? request.auth.token.gymId : "tidal-athletics";
    }
    // Gym-Verwaltungsrecht — gesetzt ausschliesslich von /api/members/role.
    // BEWUSST kein Wert von `role` (und heute eines von drei Haekchen):
    // `admin` ist der PLATTFORM-Rang und ueberspringt hier unten ueberall den
    // Gym-Vergleich; ein Haekchen in der Mitgliederliste darf niemals so weit
    // reichen. Kein legacyRole()-Rueckfall noetig — dieser Claim hiess schon
    // vor Checkpoint 3 so.
    function isVerwaltung() {
      return ("verwaltung" in request.auth.token)
             && request.auth.token.verwaltung == true;
    }
    // „Darf dieses Gym verwalten" — Plattform-Rang oder Verwaltung DIESES
    // Gyms. Serverseitige Entsprechung: canManageGym() in
    // lib/server/verify-user.ts.
    function canManageGymId(gymId) {
      return isAdmin() || (isVerwaltung() && userGymId() == gymId);
    }
    // Dokument-Seite BEWUSST strikt (kein Fallback): nur so bleiben
    // where("gymId","==",…)-Queries fuer die Rules-Engine beweisbar.
    // Altbestaende werden vor dem Rules-Deploy migriert
    // (scripts/migrate-multi-gym.mjs).
    function sameGym(data) {
      return data.gymId == userGymId();
    }
    // Trainer nur im eigenen Gym; Plattform-Admin gym-uebergreifend.
    function isGymStaffFor(data) {
      return isAdmin() || (isTrainerOrAdmin() && sameGym(data));
    }
    // ─── Persoenliche Daten eines Mitglieds (users-Subcollections) ─────────
    //
    // PRIVATES ATHLETENPROFIL (Leon 03.09.2026): Trainer sehen das Persoenliche
    // eines KOLLEGEN — Athletenprofil, Kampfprofil, Workouts, Wettkaempfe,
    // KI-Analysen — nur, wenn dieser Kollege sie freigegeben hat
    // (`profileShares` am users-Dokument, gepflegt vom Inhaber). Bei
    // ATHLETEN bleibt es wie bisher: alle Trainer desselben Gyms.
    //
    // GETRENNT JE BEREICH (Leons Revision am selben Abend): Die Freigabe ist
    // KEIN einzelner Schalter mehr, sondern eine Map von Bereich → uid-Liste:
    //
    //   users/{uid}.profileShares = {
    //     athlet:    [uid, …],   // athleteProfile, workouts, participations, Plaene
    //     deepfight: [uid, …],   // fightProfile + videoAnalyses
    //     wettkampf: [uid, …]    // fightCamps — siehe WARNUNG unten
    //   }
    //
    // Die Schluessel stehen EINMAL in lib/profile-sharing.ts; die Oberflaeche
    // liest sie von dort. Eine Freigabe auf einen Schluessel, den diese Regel
    // nicht kennt, wirkt einfach nicht — deshalb duerfen sie nie auseinander
    // laufen.
    //
    // WARUM DAS AM ELTERN-DOKUMENT HAENGT UND NICHT AN DEN FELDERN: Regeln
    // koennen einzelne Felder nicht verbergen. Deshalb sind `athlete` und
    // `fightProfile` vom users-Dokument in Unter-Sammlungen gezogen
    // (scripts/migrate-private-profile.mjs); das Dokument selbst bleibt fuer
    // die Namensliste lesbar, alles Persoenliche liegt hier darunter.
    //
    // DENY BY DEFAULT: Fehlt `profileShares` oder ist ein Bereich leer, ist ein
    // Stab-Konto dort privat — ohne Backfill, ohne Sonderfall (Konzept §3).
    // Entsprechung im Code: hasAnyRight(readRoleSet(...)) aus lib/roles.ts.
    // Der Rueckfall auf das alte `role` fehlt hier bewusst — er faellt mit
    // legacyRole() zusammen weg, und am 04.09.2026 nachgemessen trug KEINES
    // der 37 users-Dokumente nur den Altwert (0 Abweichungen). Sollte es je
    // eines geben, meldet sich das als abgewiesener Camp-Schreibvorgang
    // (ownerIsStaffStimmt unten) — laut, nicht still.
    function istStabKonto(d) {
      return d.get("trainer", false) == true
             || d.get("verwaltung", false) == true
             || d.get("admin", false) == true;
    }
    function hatFreigabe(d, bereich) {
      return request.auth.uid in d.get(["profileShares", bereich], []);
    }
    //
    // SICH SELBST DARF EIN TRAINER IMMER: Er analysiert sich „exakt wie einen
    // Schueler" (CLAUDE.md, /trainer/deepfight/me) und kuratiert dabei sein
    // eigenes Kampfprofil. Ohne diese Klausel haette ihn das Gate ausgesperrt
    // — er ist Stab-Konto und steht nicht in seiner eigenen Freigabeliste.
    // Bewusst an isTrainerOrAdmin() gebunden: Ein ATHLET schreibt sein
    // Kampfprofil weiterhin nie (Regel unten).
    function canAccessMemberData(uid, bereich) {
      let d = get(/databases/$(database)/documents/users/$(uid)).data;
      return isAdmin()
             || (isTrainerOrAdmin()
                 && (request.auth.uid == uid
                     || (sameGym(d)
                         && (!istStabKonto(d) || hatFreigabe(d, bereich)))));
    }

    // ─── Wettkampf-Freigabe: das materialisierte `ownerIsStaff` ────────────
    //
    // Eine collectionGroup-Query kann keinen get() auf das Eltern-Dokument
    // machen — sie muss allein aus dem Camp-Dokument beweisbar sein. Deshalb
    // traegt jedes Camp mit, ob sein Besitzer ein Stab-Konto ist (Muster
    // `trainerPlans.audienceUids`, Begruendung in lib/fight-camp.ts).
    //
    // GESCHRIEBEN WIRD DAS FELD VOM CLIENT — also muss es beim Schreiben
    // gegen die Wahrheit gehalten werden. Ohne diesen Vergleich koennte
    // jemand mit Wettkampf-Freigabe das Camp eines Kollegen auf false setzen
    // und es damit gym-weit sichtbar machen: aus „einer darf" wuerde „alle
    // duerfen". Der get() faellt nur beim SCHREIBEN an, nie in einer Query.
    // DIREKTER FELDZUGRIFF, KEIN get(…, default) — das Feld ist damit PFLICHT:
    // Fehlt es, ist der Ausdruck ein Auswertungsfehler und der Schreibvorgang
    // abgelehnt. Mit einem Default `false` waere ein Athleten-Camp OHNE das
    // Feld durchgegangen und danach aus der gym-weiten Liste verschwunden
    // (`== false` matcht ein fehlendes Feld nicht) — ein Camp, das niemand
    // sieht und niemand sucht.
    function ownerIsStaffStimmt(uid) {
      return request.resource.data.ownerIsStaff
             == istStabKonto(get(/databases/$(database)/documents/users/$(uid)).data);
    }

    match /users/{uid} {
      // Lesen: eigenes Profil, Trainer desselben Gyms, Verwaltung desselben
      // Gyms (Mitgliederbereich, Checkpoint 2) oder Admin.
      // DAS DOKUMENT BLEIBT FUER TRAINER LESBAR, AUCH BEI KOLLEGEN — es
      // traegt nur noch Identitaet (Name, E-Mail, Rechte-Spiegel, gymId).
      // Alles Persoenliche liegt seit 03.09.2026 in Unter-Sammlungen, und
      // dort greift canAccessMemberData() (siehe oben).
      // Die Verwaltung steht hier EIGENSTAENDIG neben dem Trainer: Sie kann
      // eine reine Buerokraft ohne Trainer-Haekchen sein — ohne diese Zeile
      // koennte sie ihre eigene Mitgliederliste nicht lesen.
      // resource == null: get() auf nicht existentes Dokument bleibt erlaubt
      // (liefert exists:false; verhindert Fehlwuerfe in Detailansichten).
      allow read: if request.auth != null
                  && (request.auth.uid == uid
                      || isAdmin()
                      || ((isTrainerOrAdmin() || isVerwaltung())
                          && (resource == null || sameGym(resource.data))));

      // Eigenes Profil anlegen (Signup) — niemals selbst ein Recht oder
      // `gymId` setzen (alles autoritativ serverseitig; gymId kommt per
      // Einladung, die Rechte per Rollen-API). Die vier Rechte-Felder sind
      // nur der Abfrage-SPIEGEL der Custom Claims; wer sie selbst schriebe,
      // gewaenne damit zwar keinen Zugriff (diese Regeln lesen ausschliesslich
      // Claims), koennte aber den Aussperr-Schutz verfaelschen, der ueber den
      // Spiegel zaehlt.
      allow create: if request.auth != null && request.auth.uid == uid
                    && !request.resource.data.keys().hasAny(["role", "trainer", "verwaltung", "admin", "gymId", "gymJoinedAt"]);

      // Eigenes Profil aktualisieren — aber NIEMALS eines der vier
      // Rechte-Felder (`role`, `trainer`, `verwaltung`, `admin`: der Spiegel
      // darf den Claim nicht ueberholen), `gymId` (Gym-Wechsel nur
      // serverseitig), `gymJoinedAt` (das Beitrittsdatum setzt der Server beim
      // Einloesen; selbst gesetzt waere es eine erfundene Zugehoerigkeit) oder
      // `fightProfile` (kuratieren ausschliesslich Trainer/Admins).
      allow update: if request.auth != null && request.auth.uid == uid
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["role", "trainer", "verwaltung", "admin", "gymId", "gymJoinedAt", "fightProfile"]);

      // UEBERGANG — ENTFAELLT NACH DER MIGRATION (Backlog): Das Kampfprofil
      // liegt seit 03.09.2026 in users/{uid}/fightProfile/main. Diese Zeile
      // bleibt nur, damit der Produktions-Client zwischen Rules-Deploy und
      // Code-Deploy weiter schreiben kann. Danach mit legacyRole() zusammen
      // ausbauen.
      allow update: if request.auth != null && isGymStaffFor(resource.data)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["fightProfile"]);

      // Admin verwaltet Profile (inkl. gymId-Zuordnung), aber ALLE Rechte
      // werden AUSSCHLIESSLICH per Admin-SDK (Custom Claims) gesetzt — der
      // Spiegel im Dokument darf nie von Hand vom Claim abweichen, sonst
      // zaehlt der Aussperr-Schutz falsch.
      allow create: if request.auth != null && isAdmin()
                    && !request.resource.data.keys().hasAny(["role", "trainer", "verwaltung", "admin"]);
      allow update: if request.auth != null && isAdmin()
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["role", "trainer", "verwaltung", "admin"]);
      allow delete: if request.auth != null && isAdmin();

      // Generische Subcollections (workouts, athleteProfile, participations …)
      // — der Bereich „athlet" der Freigabe.
      //
      // WICHTIG: `videoAnalyses` und `fightProfile` sind im OWNER-Zweig BEWUSST
      // AUSGENOMMEN — der Owner darf rohe KI-Analysen ueber sich weder frei
      // lesen noch schreiben, und sein Kampfprofil (die kuratierte Auswertung)
      // nur lesen, nie schreiben (eigene Regeln unten).
      //
      // SEIT DER TRENNUNG JE BEREICH GILT DIESELBE AUSNAHME AUCH FUER DEN
      // TRAINER-ZWEIG, und zusaetzlich fuer `fightCamps`: Solange EINE Freigabe
      // fuer alles galt, war es gleichgueltig, ob dieser Wildcard die drei
      // mitdeckt — die Bedingung war ueberall dieselbe. Jetzt nicht mehr. Ohne
      // die Ausnahme oeffnete ein Haekchen bei „Athletenprofil & Training"
      // stillschweigend auch Kampfprofil, Analysen und Wettkaempfe, weil
      // Firestore-Regeln ODER-verknuepft sind und der grosszuegigere Zweig
      // gewinnt. Genau diese Falle steckt weiter unten in der
      // collectionGroup-Regel fuer fightCamps (dort noch offen, s. u.).
      match /{subcollection}/{document=**} {
        // OWNER-LESEN: fightCamps bleiben dabei — jeder sieht seine eigenen
        // Wettkaempfe (Athleten-Dashboard).
        allow read: if request.auth != null && request.auth.uid == uid
                    && subcollection != "videoAnalyses"
                    && subcollection != "fightProfile";
        // OWNER-SCHREIBEN OHNE fightCamps (Schritt 2b): Sonst koennte der
        // Besitzer `ownerIsStaff` frei setzen und den Vergleich unten
        // umgehen. Kein Verlust — Camps legt und pflegt ausschliesslich der
        // Trainerbereich; die Regel darunter laesst den Besitzer weiterhin
        // durch, nur eben mit dem Vergleich.
        allow write: if request.auth != null && request.auth.uid == uid
                     && subcollection != "videoAnalyses"
                     && subcollection != "fightProfile"
                     && subcollection != "fightCamps";
        allow read: if request.auth != null
                    && subcollection != "videoAnalyses"
                    && subcollection != "fightProfile"
                    && subcollection != "fightCamps"
                    && canAccessMemberData(uid, "athlet");

        // Admin schreibt in alle Sub-Collections (Demo-Seed) — fightCamps
        // ausgenommen, damit der `ownerIsStaff`-Vergleich unten AUSNAHMSLOS
        // gilt. Ein Camp, das an dieser Regel vorbei mit falschem Feld
        // entstuende, waere in keiner Liste zu sehen und in keiner zu suchen.
        allow write: if request.auth != null && isAdmin()
                     && subcollection != "fightCamps";
      }

      // Persoenliche Workoutplan-Kopien (Etappe Workout-Plaene, Teilschritt 3):
      // der Owner liest/schreibt NUR seine eigenen Kopien. Heute schon von der
      // generischen Subcollection-Regel oben abgedeckt — hier EXPLIZIT, damit
      // die Kopien einen spaeteren Zuschnitt der generischen Regel ueberleben.
      match /workoutPlans/{planId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Trainer + Admin verwalten Wettkaempfe (fightCamps) — eigenes Gym,
      // bei Kollegen nur mit Freigabe im Bereich „wettkampf".
      //
      // DIESE ZEILE HAELT SEIT DEM 04.09.2026 (Schritt 2b). Bis dahin
      // ueberstimmte die collectionGroup-Regel weiter unten sie: `{path=**}`
      // matcht denselben Pfad und prueft dort nur `sameGym` — und weil
      // Firestore-Regeln ODER-verknuepft sind, gewinnt die grosszuegigere. Ein
      // Camp war damit fuer jeden Trainer des Gyms lesbar (per REST gemessen),
      // und eine erteilte Freigabe aenderte daran nichts. Geschlossen wurde es
      // nicht hier, sondern DORT: Die collectionGroup-Regel sortiert Camps von
      // Stab-Konten jetzt ueber `ownerIsStaff` aus, sodass sie nur noch ueber
      // diese Zeile ihren Weg finden.
      //
      // SCHREIBEN GETRENNT VOM LESEN, weil `request.resource` beim Loeschen
      // null ist — ein `allow write` mit ownerIsStaffStimmt() waere dort ein
      // Auswertungsfehler und damit eine Ablehnung. Create und Update tragen
      // den Vergleich, Delete braucht ihn nicht: Ein geloeschtes Camp kann
      // nichts mehr behaupten.
      match /fightCamps/{campId} {
        allow read: if request.auth != null
                    && canAccessMemberData(uid, "wettkampf");
        allow create, update: if request.auth != null
                              && canAccessMemberData(uid, "wettkampf")
                              && ownerIsStaffStimmt(uid);
        allow delete: if request.auth != null
                      && canAccessMemberData(uid, "wettkampf");
      }

      // Kampfprofil = kuratierte DeepFight-Auswertung (lib/fight-profile.ts).
      // Owner liest, schreibt NIE (Kuratieren ist Trainersache); Trainer
      // lesen und schreiben — bei Kollegen nur mit Freigabe im Bereich
      // „deepfight". Er umfasst Kampfprofil UND Analysen gemeinsam: Das eine
      // IST die Auswertung des anderen, getrennt freizugeben ergaebe fachlich
      // nichts.
      match /fightProfile/{docId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow read, write: if request.auth != null
                           && canAccessMemberData(uid, "deepfight");
      }

      // KI-Video-Analysen des Athleten (Konzept §6, mode=athlete).
      // Athlet: liest NUR vom Trainer freigegebene Auswertungen, schreibt NIE.
      // (Queries brauchen where("sharedWithAthlete","==",true).)
      match /videoAnalyses/{analysisId} {
        allow read: if request.auth != null && request.auth.uid == uid
                    && resource.data.sharedWithAthlete == true;
        allow read, write: if request.auth != null
                           && canAccessMemberData(uid, "deepfight");
      }
    }

    // CollectionGroup-Query: zentraler Wettkampfbereich liest fightCamps
    // gym-weit ueber alle Athleten — nur eigenes Gym und nur ATHLETEN-Camps.
    // Die Query braucht deshalb BEIDE Filter:
    //   where("gymId","==",…) und where("ownerIsStaff","==",false)
    // (lib/fight-camp.ts, listAllFightCamps). Fehlt einer, ist die Query fuer
    // die Rules-Engine nicht beweisbar und wird KOMPLETT abgelehnt — sie
    // liefert nicht etwa weniger Dokumente.
    //
    // ═══ WARUM HIER `ownerIsStaff` STEHT — die Luecke von Schritt 2b ══════
    // `{path=**}` matcht NICHT nur collectionGroup-Queries. Es matcht auch den
    // direkten Pfad `users/{uid}/fightCamps/{campId}` — also genau den, den die
    // strenge Regel oben mit `canAccessMemberData(uid, "wettkampf")` schuetzen
    // soll. Firestore-Regeln sind ODER-verknuepft: Eine strengere Regel daneben
    // schraenkt nichts ein, die grosszuegigere gewinnt. Solange hier nur
    // `sameGym` stand, las jeder Trainer des Gyms jedes Camp.
    //
    // Per REST mit echten ID-Tokens belegt (Trainer A auf Trainer B), VOR dem
    // Fix:
    //   Camp von B direkt lesen, KEINE Freigabe   → 200  (sollte 403 sein)
    //   athleteProfile von B, KEINE Freigabe      → 403  (Gate wirkt dort)
    //   Camp aus fremdem Gym                      → 403  (sameGym haelt)
    //   Camp von B NACH erteilter Freigabe        → 200  (unveraendert)
    //
    // Eine Query kann keinen `get()` auf das Eltern-Dokument machen — die
    // Regel muss allein aus dem Camp-Dokument beweisbar sein. Deshalb traegt
    // jedes Camp die Antwort mit (`ownerIsStaff`, Muster
    // `trainerPlans.audienceUids`), und diese Regel deckt nur noch die Camps
    // ab, um die es ihr geht: die der Athleten. Die Camps von Stab-Konten
    // finden ausschliesslich ueber die strenge Regel oben ihren Weg — und
    // damit ueber die Freigabe.
    //
    // ═══ WARUM HIER `resource.data.ownerIsStaff` UND NICHT `.get(…, false)`
    // GEMESSEN AM 04.09.2026, per REST mit echtem Trainer-Token. Ein erster
    // Anlauf schrieb `resource.data.get("ownerIsStaff", false) == false` —
    // sicher gegen Camps ohne das Feld, und deshalb naheliegend. Ergebnis:
    //
    //   Query nur mit gymId + orderBy  → HTTP 200, Stab-Camp WAR DABEI
    //
    // Die Query-Analyse der Rules-Engine versteht die `.get()`-Form NICHT als
    // Einschraenkung. Sie verlangt daraufhin auch keinen passenden Filter und
    // laesst die Abfrage durch — die Luecke blieb offen, obwohl die Regel
    // richtig aussah. Nur der DIREKTE Feldzugriff zwingt die Query, den Filter
    // `where("ownerIsStaff","==",false)` mitzubringen.
    //
    // Preis: Ein Camp OHNE das Feld ist hier ein Auswertungsfehler und damit
    // verboten. Das ist die richtige Richtung (Deny by Default) und der Grund,
    // warum der Backfill VOR diesem Deploy laufen muss
    // (scripts/backfill-fight-camp-owner.mjs, Reihenfolge im Script-Kopf) und
    // warum `ownerIsStaffStimmt` das Feld bei jedem Schreibvorgang erzwingt.
    // ═════════════════════════════════════════════════════════════════════
    match /{path=**}/fightCamps/{campId} {
      allow read: if request.auth != null
                  && resource.data.ownerIsStaff == false
                  && (isAdmin() || (isTrainerOrAdmin() && sameGym(resource.data)));
    }

    // CollectionGroup-Query: Kennzahlen des Gyms lesen Teilnahmen ueber ALLE
    // Mitglieder (Trainer- und Verwaltungs-Uebersicht) — nur eigenes Gym,
    // Admin gym-uebergreifend. Die Query braucht where("gymId","==",…).
    //
    // WARUM DIE VERWALTUNG EIGENSTAENDIG DANEBEN STEHT: Sie kann eine reine
    // Buerokraft ohne Trainer-Haekchen sein; ohne diese Zeile saehe sie die
    // Kennzahlen ihres eigenen Gyms nicht.
    //
    // SCHREIBEN IST HIER NICHT ERLAUBT — es bleibt beim Besitzer (Regel in
    // der users-Subcollection oben). Eine Teilnahme ist eine Aussage ueber
    // sich selbst; wer sie fuer andere setzen koennte, koennte Kennzahlen
    // faelschen.
    match /{path=**}/participations/{participationId} {
      allow read: if request.auth != null
                  && (isAdmin()
                      || ((isTrainerOrAdmin() || isVerwaltung())
                          && sameGym(resource.data)));
    }

    // Gym-Stammdaten (Multi-Gym): Mitglieder lesen ihr eigenes Gym,
    // Admin verwaltet alle. Verwaltungs-Schreibrechte kommen in Phase 2
    // ausschliesslich ueber serverseitige APIs (Admin-SDK), nie per Client.
    match /gyms/{gymId} {
      allow read: if request.auth != null
                  && (isAdmin() || userGymId() == gymId);
      allow write: if request.auth != null && isAdmin();

      // Gym-Workoutplaene (Etappe Workout-Plaene): Gym-Scope liegt im PFAD —
      // Mitglieder lesen die Plaene ihres Gyms, Trainer desselben Gyms
      // pflegen sie; Admin gym-uebergreifend. Persoenliche Kopien liegen in
      // users/{uid}/workoutPlans (explizite Owner-Regel dort).
      match /workoutPlans/{planId} {
        allow read: if request.auth != null
                    && (isAdmin() || userGymId() == gymId);
        allow write: if request.auth != null
                     && (isAdmin()
                         || (isTrainerOrAdmin() && userGymId() == gymId));
      }

      // Einladungen (Multi-Gym Phase 2, Konzept §5) — der Mechanismus, der
      // die Mandantentrennung herstellt: Einloesen setzt den gymId-Claim.
      // SCHREIBEN IST HIER GANZ VERBOTEN. Erzeugt, zurueckgezogen und
      // eingeloest wird ausschliesslich ueber /api/invites (Admin-SDK).
      // Grund: Duerfte ein Trainer Einladungen selbst schreiben, koennte er
      // sich eine mit role="admin" ausstellen und einloesen — Rechte-
      // ausweitung ueber Umwege.
      //
      // LESEN NUR DIE VERWALTUNG (Leon 31.08.): Wer die Codes sieht, kann sie
      // weiterreichen — also einladen. Ein Trainer ohne Einladungsrecht darf
      // die Liste deshalb nicht lesen. Bis Checkpoint 2 stand hier
      // stellvertretend isAdmin(), weil es den Verwaltungs-Claim noch nicht
      // gab; seither prueft canManageGymId() den Zielzustand.
      // Eingeladene brauchen ohnehin keinen Lesezugriff — der Beitritt laeuft
      // serverseitig ueber /api/invites/redeem.
      match /invites/{code} {
        allow read: if request.auth != null && canManageGymId(gymId);
        allow write: if false;
      }

      // Protokoll rechteveraendernder Vorgaenge (Konzept §4) und zugleich
      // Quelle des Neuigkeiten-Bereichs (Checkpoint 2). Ebenfalls rein
      // serverseitig geschrieben — ein Protokoll, das der Betroffene aendern
      // kann, ist keines. Lesen wie bei den Einladungen nur die Verwaltung:
      // die Eintraege enthalten die Codes im Klartext.
      match /auditLog/{entryId} {
        allow read: if request.auth != null && canManageGymId(gymId);
        allow write: if false;
      }

      // Trainer-Plaene mit Freigabe (Workout-Plaene AUSBAU Stufe 1):
      // Sichtbarkeit liegt SERVERSEITIG in audienceUids (beim Freigeben
      // materialisierte Schueler-Auswahl, Muster opponents.sharedWith) —
      // bewusst KEIN Client-Filter wie frueher sharedWithAthlete. Athleten-
      // Queries MUESSEN where("audienceUids","array-contains", eigene uid)
      // filtern, sonst weist die Rules-Engine sie ab.
      match /trainerPlans/{planId} {
        allow read: if request.auth != null
                    && (isAdmin()
                        || (isTrainerOrAdmin() && userGymId() == gymId)
                        || (userGymId() == gymId
                            && request.auth.uid in resource.data.audienceUids));
        allow write: if request.auth != null
                     && (isAdmin()
                         || (isTrainerOrAdmin() && userGymId() == gymId));
      }
    }

    // Gegner-DNA-Bibliothek — pro Gym. Trainer sehen/pflegen nur die
    // Bibliothek des eigenen Gyms; Schueler lesen explizit freigegebene
    // Profile (sharedWith enthaelt ihre uid). Ein Update kann das Profil
    // nicht in ein anderes Gym verschieben.
    match /opponents/{opponentId} {
      allow read: if request.auth != null
                  && (isGymStaffFor(resource.data)
                      || request.auth.uid in resource.data.sharedWith);
      allow create: if request.auth != null && isGymStaffFor(request.resource.data);
      allow update: if request.auth != null && isGymStaffFor(resource.data)
                    && isGymStaffFor(request.resource.data);
      allow delete: if request.auth != null && isGymStaffFor(resource.data);

      // KI-Video-Analysen zum Gegner (Konzept §6, mode=opponent) —
      // Gym-Scope ueber das Eltern-Gegnerprofil.
      match /videoAnalyses/{analysisId} {
        allow read, write: if request.auth != null
                           && (isAdmin()
                               || (isTrainerOrAdmin()
                                   && sameGym(get(/databases/$(database)/documents/opponents/$(opponentId)).data)));
      }
    }

    // Zaehlbremse gegen Code-Durchprobieren (Checkpoint 1C,
    // lib/server/rate-limit.ts). Rein serverseitig: gelesen und geschrieben
    // wird ausschliesslich per Admin-SDK in /api/invites/preview und /redeem.
    // Deshalb hier explizit ZU — auch fuer den Betroffenen selbst. Laege der
    // Zaehler am eigenen users-Dokument, koennte er ihn selbst zuruecksetzen
    // und die Bremse waere wirkungslos.
    match /inviteAttempts/{uid} {
      allow read, write: if false;
    }

    // Laufende KI-Kosten-Summe + Budget (Guthaben-Anzeige der Video-Analyse).
    // Pro-Gym-Kontingent folgt in Phase 3 (aiUsage/{gymId}).
    match /aiUsage/{docId} {
      allow read, write: if request.auth != null && isTrainerOrAdmin();
    }

    // Trainer-zugewiesene Trainingsinhalte (Curriculum) — bewusst fuer alle
    // eingeloggten Mitglieder lesbar. Gym-Scoping folgt in Phase 3 mit dem
    // Wochenplan-Mehrplan-Modell (gyms/{gymId}/schedulePlans).
    match /trainingSessions/{document=**} {
      allow read: if request.auth != null;
      // Pflegen duerfen Trainer UND Verwaltung (Konzept §7: „Inhalte pflegen
      // Verwaltung + Trainer, Aktivieren nur Verwaltung"). Bis 2026-09-01 stand
      // hier nur isTrainerOrAdmin() — eine reine Verwaltung sah den Wochenplan
      // dadurch nur lesend, obwohl das Konzept ihr die Pflege ausdruecklich
      // zuschreibt (Leons Freigabe 01.09.).
      //
      // NOCH NICHT GYM-GESCOPED: `trainingSessions` tragen kein gymId. Das ist
      // Bestand und aendert sich mit dem Mehrplan-Modell in Phase 3
      // (gyms/{gymId}/schedulePlans) — bis dahin gilt dieselbe Offenheit, die
      // Trainer hier schon immer hatten.
      allow write: if request.auth != null && (isTrainerOrAdmin() || isVerwaltung());
    }

    // Anonyme Technik-Aufruf-Zaehler: nur Hochzaehlen erlaubt (viewCount/lastViewed),
    // keine fremden Felder einschleusbar. Lesen nur Trainer/Admin.
    match /techniqueStats/{techniqueId} {
      allow read: if request.auth != null && isTrainerOrAdmin();
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(["viewCount", "lastViewed"]);
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(["viewCount", "lastViewed"]);
    }
  }
}
