rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function userRole() {
      // Rolle kommt autoritativ aus den Auth Custom Claims (per Admin-SDK gesetzt),
      // NICHT mehr aus dem Firestore-Dokument — kein Client kann sie schreiben.
      return request.auth.token.role;
    }
    function isTrainerOrAdmin() {
      return userRole() in ["trainer", "admin"];
    }
    function isAdmin() {
      return userRole() == "admin";
    }

    match /users/{uid} {
      // Lesen: eigenes Profil oder Trainer/Admin
      allow read: if request.auth != null
                  && (request.auth.uid == uid || isTrainerOrAdmin());

      // Eigenes Profil anlegen (Signup) — niemals selbst ein `role`-Feld setzen
      allow create: if request.auth != null && request.auth.uid == uid
                    && !("role" in request.resource.data);

      // Eigenes Profil aktualisieren — aber NIEMALS `role` (Privilege-Escalation)
      // oder `fightProfile` aendern: das Kampfprofil (DeepFight-Merge-Ziel)
      // kuratieren ausschliesslich Trainer/Admins; der Owner liest es nur.
      allow update: if request.auth != null && request.auth.uid == uid
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["role", "fightProfile"]);

      // Trainer pflegen das Kampfprofil ihrer Athleten (und ihr eigenes):
      // Update ausschliesslich auf das Feld `fightProfile`, sonst nichts.
      allow update: if request.auth != null && isTrainerOrAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["fightProfile"]);

      // Admin verwaltet Profile, aber die Rolle wird AUSSCHLIESSLICH per
      // Admin-SDK-Script (Custom Claims) gesetzt — kein Client-Pfad schreibt `role`.
      allow create: if request.auth != null && isAdmin()
                    && !("role" in request.resource.data);
      allow update: if request.auth != null && isAdmin()
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["role"]);
      allow delete: if request.auth != null && isAdmin();

      match /{subcollection}/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
        allow read: if request.auth != null && isTrainerOrAdmin();

        // Admin schreibt in alle Sub-Collections (Demo-Seed)
        allow write: if request.auth != null && isAdmin();
      }

      // Trainer + Admin verwalten Wettkaempfe (fightCamps) fuer ihre Schueler
      match /fightCamps/{campId} {
        allow read, write: if request.auth != null && isTrainerOrAdmin();
      }

      // KI-Video-Analysen des eigenen Athleten (Konzept §6, mode=athlete)
      match /videoAnalyses/{analysisId} {
        allow read, write: if request.auth != null && isTrainerOrAdmin();
      }
    }

    // CollectionGroup-Query: zentraler Wettkampfbereich liest alle fightCamps
    // gym-weit ueber alle Schueler. Schreiben bleibt ueber den users-Pfad oben.
    match /{path=**}/fightCamps/{campId} {
      allow read: if request.auth != null && isTrainerOrAdmin();
    }

    // Gegner-DNA-Bibliothek (gym-weit geteilte Gegnerprofile).
    // Schueler duerfen Profile LESEN, die ein Trainer explizit fuer sie
    // freigegeben hat (sharedWith enthaelt ihre uid) — Schreiben bleibt
    // ausschliesslich Trainer/Admin.
    match /opponents/{opponentId} {
      allow read: if request.auth != null
                  && (isTrainerOrAdmin()
                      || request.auth.uid in resource.data.get("sharedWith", []));
      allow write: if request.auth != null && isTrainerOrAdmin();

      // KI-Video-Analysen zum Gegner (Konzept §6, mode=opponent)
      match /videoAnalyses/{analysisId} {
        allow read, write: if request.auth != null && isTrainerOrAdmin();
      }
    }

    // Laufende KI-Kosten-Summe + Budget (Guthaben-Anzeige der Video-Analyse)
    match /aiUsage/{docId} {
      allow read, write: if request.auth != null && isTrainerOrAdmin();
    }

    // Trainer-zugewiesene Trainingsinhalte (gym-weites Curriculum) — bewusst
    // fuer alle eingeloggten Mitglieder lesbar. Schreiben nur Trainer/Admin.
    match /trainingSessions/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isTrainerOrAdmin();
    }

    // Anonyme Technik-Aufruf-Zaehler: nur Hochzaehlen erlaubt (viewCount/lastViewed),
    // keine fremden Felder einschleusbar. Lesen nur Trainer/Admin.
    match /techniqueStats/{techniqueId} {
      allow read: if request.auth != null && isTrainerOrAdmin();
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(["viewCount", "lastViewed"]);
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(["viewCount", "lastViewed"]);
    }
  }
}
